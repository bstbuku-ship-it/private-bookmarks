{
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "key": "",
  "name": "私密书签管家",
  "version": "1.0.0",
  "description": "带密码、加密存储的私密书签库：手动或批量添加，自建文件夹分类，加密备份，可设置解锁有效期，支持检查更新。",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "favicon",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "私密书签管家",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}